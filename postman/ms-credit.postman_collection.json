      "name": "02 - Find credit by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Credit is returned by ID', () => pm.expect(pm.response.json().id).to.equal(pm.collectionVariables.get('creditId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
