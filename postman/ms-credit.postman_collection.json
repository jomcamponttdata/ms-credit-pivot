              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Payment receipt is returned', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.movementType).to.equal('PAYMENT');",
              "    pm.expect(body.amount).to.equal(100);",
              "    pm.collectionVariables.set('creditMovementId', body.movementId);",
              "});"
            ]
