{
  "info": {
    "_postman_id": "d2d2e6e4-6fb6-4f02-aec9-07c8d71b6c11",
    "name": "ms-credit - Part I",
    "description": "Credit and credit-card tests. Set customerId to an ACTIVE PERSONAL customer with no bank accounts and businessCustomerId to an ACTIVE BUSINESS customer from ms-customer. The first read-only request checks the no-bank-account precondition via ms-account; personal credit creation then proves a bank account is not required. Requires PostgreSQL, ms-customer, ms-account and ms-transaction.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "exec": [
          "pm.collectionVariables.set('correlationId', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Verify personal customer has no bank accounts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Account service answers the precondition query', () => pm.response.to.have.status(200));",
              "pm.test('Personal credit test customer has no bank accounts', () => pm.expect(pm.response.json()).to.be.an('array').that.is.empty);"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{accountBaseUrl}}/api/v1/accounts?customerId={{customerId}}&page=0&size=20",
          "host": [
            "{{accountBaseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ],
          "query": [
            {
              "key": "customerId",
              "value": "{{customerId}}"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Create personal credit without a bank account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Initial outstanding balance equals the approved amount', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.creditType).to.equal('PERSONAL');",
              "    pm.expect(body.outstandingBalance).to.equal(5000);",
              "    pm.expect(body.status).to.equal('ACTIVE');",
              "    pm.expect(pm.response.headers.get('Location')).to.equal('/api/v1/credits/' + body.id);",
              "    pm.collectionVariables.set('creditId', body.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customerId\": \"{{customerId}}\",\n  \"creditType\": \"PERSONAL\",\n  \"approvedAmount\": 5000.00,\n  \"currency\": \"PEN\",\n  \"interestRate\": 18.5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/credits",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "credits"
          ]
        }
      },
      "response": []
