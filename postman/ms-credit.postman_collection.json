            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Credit balance is returned', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.productId).to.equal(pm.collectionVariables.get('creditId'));",
              "    pm.expect(body.productType).to.equal('CREDIT');",
              "    pm.expect(body.balance).to.equal(5000);",
              "});"
            ]
