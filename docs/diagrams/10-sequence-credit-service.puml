== 11. Actualizar límite (PUT /api/v1/credit-cards/{creditCardId}) ==
User -> Controller : PUT /api/v1/credit-cards/{creditCardId}\nCreditCardUpdateRequest
Controller -> Service : update(creditCardId, command): Single<CreditCard>
Service -> Repo : findById(creditCardId)
Repo -> DB : SELECT tarjeta y version
alt no existe
  Service --> Controller : ResourceNotFoundException
  Controller --> User : 404 Not Found
else existe
  DB --> Repo : límite y crédito disponible actuales
  Repo --> Service : Maybe<CreditCard>
  Service -> Service : crédito usado = límite - disponible;\nvalidar nuevo límite >= crédito usado;\nrecalcular disponible = nuevo límite - usado
  alt regla inválida
    Service --> Controller : BusinessRuleViolationException
    Controller --> User : 422 Unprocessable Entity
  else regla válida
    Service -> Repo : save(tarjeta actualizada)
    Repo -> DB : UPDATE con control optimista
    alt versión desactualizada
      Repo --> Service : ConcurrentModificationException
      Controller --> User : 409 Conflict
    else guardado
      DB --> Repo : tarjeta actualizada
      Repo --> Service : Single<CreditCard>
      Controller --> User : 200 OK + CreditCard
    end
  end
end
note over Controller, User
  Solicitud inválida: 400 Bad Request.
end note

== 12. Eliminar tarjeta (DELETE /api/v1/credit-cards/{creditCardId}) ==
User -> Controller : DELETE /api/v1/credit-cards/{creditCardId}
Controller -> Service : delete(creditCardId): Completable
Service -> Repo : findById(creditCardId)
Repo -> DB : SELECT tarjeta
alt no existe
  Service --> Controller : ResourceNotFoundException
  Controller --> User : 404 Not Found
else existe
  Service -> Repo : delete(tarjeta con version)
  Repo -> DB : DELETE tarjeta
  DB --> Repo : OK
  Controller --> User : 204 No Content
end

== 13. Consultar crédito disponible (GET /api/v1/credit-cards/{creditCardId}/balance) ==
User -> Controller : GET /api/v1/credit-cards/{creditCardId}/balance
Controller -> Service : getBalance(creditCardId): Single<Balance>
Service -> Repo : findById(creditCardId)
Repo -> DB : SELECT tarjeta
alt no existe
  Service --> Controller : ResourceNotFoundException
  Controller --> User : 404 Not Found
else existe
  Repo --> Service : Maybe<CreditCard>
  Service --> Controller : Balance(availableCredit)
  Controller --> User : 200 OK + Balance\n(productType=CREDIT_CARD)
end

== 14. Cargar consumo (POST /api/v1/credit-cards/{creditCardId}/charges) ==
User -> Controller : POST /api/v1/credit-cards/{creditCardId}/charges\nOperationRequest
Controller -> Service : charge(command): Single<MovementReceipt>
Service -> Repo : findById(creditCardId)
Repo -> DB : SELECT tarjeta y version
alt tarjeta no existe
  Service --> Controller : ResourceNotFoundException
  Controller --> User : 404 Not Found
else tarjeta existente
  DB --> Repo : crédito disponible y version
  Repo --> Service : Maybe<CreditCard>
  Service -> Service : validar cargo <= disponible;\nreducir crédito disponible
  alt importe o moneda no válidos
    Service --> Controller : BusinessRuleViolationException
    Controller --> User : 422 Unprocessable Entity
  else cargo válido
    Service -> Repo : save(tarjeta actualizada)
    Repo -> DB : UPDATE con control optimista de versión
    alt versión desactualizada
      Repo --> Service : ConcurrentModificationException
      Controller --> User : 409 Conflict
    else guardado
      DB --> Repo : tarjeta actualizada
      Repo --> Service : Single<CreditCard>
      Service -> MovementGw : register(CREDIT_CARD, CHARGE, ...)
      MovementGw -> TransactionSvc : POST /api/v1/movements\nMovementRequest\nX-Correlation-ID: {id}
      alt movimiento registrado
        TransactionSvc --> MovementGw : 201 Created + Movement\nX-Correlation-ID: {id}
        MovementGw --> Service : Single<MovementReceipt>
        Service --> Controller : MovementReceipt
       Controller --> User : 201 Created + MovementReceipt
      else fallo confirmado (respuesta 4xx)
        TransactionSvc --> MovementGw : error definitivo\nX-Correlation-ID: {id}
        MovementGw --> Service : error no ambiguo
        Service -> Repo : restaurar crédito disponible original
        Repo -> DB : UPDATE compensatorio
        Controller --> User : 503 Service Unavailable
      else timeout, transporte o respuesta 5xx
        MovementGw --> Service : error ambiguo
        note right of Service
          No compensar; requiere reconciliación.
        end note
        Controller --> User : 503 Service Unavailable
      end
    end
  end
end
note over Controller, User
  Solicitud inválida: 400 Bad Request.
end note

